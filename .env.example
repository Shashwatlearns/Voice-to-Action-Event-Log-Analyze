# Copy to .env and adjust. All variables are optional.

# Where tasks are persisted (SQLite)
VTA_DB_PATH=data/tasks.db

# spaCy model used for NER (must be downloaded: python -m spacy download en_core_web_sm)
VTA_SPACY_MODEL=en_core_web_sm

# Speech-to-text backend: google | whisper | faster-whisper
VTA_VOICE_BACKEND=google

# Whisper model size when using whisper / faster-whisper: tiny | base | small | medium | large-v3
VTA_WHISPER_MODEL=base

# Recognition language (BCP-47)
VTA_LANGUAGE=en-US

# Tasks due within this many minutes are flagged as "due soon"
VTA_DUE_SOON_MINUTES=15

# Hour (24h) used for "end of day" / "EOD" deadlines
VTA_EOD_HOUR=18
